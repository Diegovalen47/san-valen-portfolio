---
import type { languages } from '../../i18n/ui';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { skillsCategories } from '../../data/skills';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang as keyof typeof languages)
---

<div class="space-y-10">
  {skillsCategories.map((category) => (
    <div>
      <h3 class="px-4 text-xl font-bold mb-4 text-gray-800 dark:text-white">{t(category.titleKey)}</h3>
      {category.descriptionKey && (
        <p class="px-4 mb-4 text-base text-gray-600 dark:text-gray-300">{t(category.descriptionKey)}</p>
      )}
      <ul class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-6 lg:grid-cols-8 gap-4">
        {category.skills.map((skill) => (
          <li class="col-span-1">
            <div class="flex flex-col items-center justify-center">
              <img src={skill.logo.src} alt={`${skill.name} logo`} class:list={['w-12 h-12', skill.darkClass]}>
              <span class="text-sm text-gray-700 dark:text-white pt-2">{skill.name}</span>
            </div>
          </li>
        ))}
      </ul>
    </div>
  ))}
</div>
